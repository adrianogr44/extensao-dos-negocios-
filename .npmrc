onlyBuiltDependencies[]="@prisma/client"
onlyBuiltDependencies[]="@prisma/engines"
onlyBuiltDependencies[]="prisma"
onlyBuiltDependencies[]="esbuild"
onlyBuiltDependencies[]="msgpackr-extract"
onlyBuiltDependencies[]="spawn-sync"
onlyBuiltDependencies[]="unrs-resolver"
onlyBuiltDependencies[]="lmdb"
onlyBuiltDependencies[]="subleveldown"
onlyBuiltDependencies[]="classic-level"
onlyBuiltDependencies[]="better-sqlite3"

# Evita que o pnpm rode `pnpm install` automaticamente antes de `pnpm run`
# (era ele que abortava o dev do dashboard por falta de TTY no purge).
verify-deps-before-run=false
# Purga do node_modules sem pedir confirmação interativa.
confirm-modules-purge=false
