{
  "name": "postreels-v2",
  "version": "0.1.0",
  "description": "PostReels v2 — Instagram Reels download automation + overlay editor",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:migrate": "pnpm --filter @postreels/dashboard exec prisma migrate dev",
    "db:push": "pnpm --filter @postreels/dashboard exec prisma db push",
    "db:studio": "pnpm --filter @postreels/dashboard exec prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
