{
  "manifest_version": 3,
  "name": "Fábrica de Reels - Downloader",
  "version": "1.0",
  "description": "Baixa todos os Reels de um perfil do Instagram diretamente pelo navegador.",
  "permissions": ["downloads", "storage", "scripting", "tabs"],
  "host_permissions": ["*://*.instagram.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "web_accessible_resources": [{
    "resources": ["content.js"],
    "matches": ["*://*.instagram.com/*"]
  }]
}
